{
  "$schema": "https://solid-ui.com/schema.json",
  "tsx": true,
  "tailwind": {
    "css": "src/app.css",
    "config": "tailwind.config.cjs",
    "prefix": ""
  },
  "aliases": {
    "components": "~/features/ui/components",
    "ui": "~/features/ui",
    "utils": "~/features/lib/utils"
  },
  "components": {
    "path": "src/features/ui/components",
    "available": [
      "accordion",
      "alert-dialog",
      "async-select",
      "avatar",
      "badge",
      "badge-delta",
      "breadcrumb",
      "button",
      "card",
      "carousel",
      "checkbox",
      "collapsible",
      "command",
      "date-picker",
      "dialog",
      "drawer",
      "dropdown-menu",
      "empty-state",
      "error-state",
      "field",
      "hover-card",
      "input",
      "label",
      "menubar",
      "navigation-menu",
      "number-field",
      "otp-field",
      "pagination",
      "popover",
      "radio-group",
      "resizable",
      "select",
      "separator",
      "settings-modal",
      "sheet",
      "sidebar",
      "skeleton",
      "slider",
      "sonner",
      "switch",
      "table",
      "tabs",
      "text-field",
      "textarea",
      "theme-toggle",
      "timeline",
      "toggle",
      "toggle-group",
      "tooltip"
    ]
  }
}
