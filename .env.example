VITE_API_URL=http://localhost:9070

# Realtime features (optional — enable as needed)
# VITE_WS_URL=ws://localhost:9070/ws
# VITE_SSE_URL=http://localhost:9070/events
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Google Maps API key (required if using Google Maps provider)
# VITE_APP_GOOGLE_MAP_API_KEY=your-google-maps-api-key-here

# Map build mode — controls which map provider code is bundled at build time
# Options: both | leaflet | google | none  (default: both)
# VITE_MAP_BUILD_MODE=both

# CMS editor — controls which rich text editor is bundled at build time
# Options: quill | none  (default: quill)
# VITE_CMS_EDITOR=quill
