{
  "name": "cms-boilerplate-solid",
  "version": "1.0.0",
  "description": "A production-ready SolidJS admin panel boilerplate with TanStack Router, TanStack Query, Kobalte UI, Tailwind CSS v4, i18n, RBAC, charts, maps, and more.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/cms-boilerplate-solid.git"
  },
  "keywords": ["solidjs", "admin-panel", "cms", "boilerplate", "tanstack", "kobalte", "tailwindcss", "typescript"],
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build && tsc",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true bunx --bun vite build && xdg-open dist/stats.html",
    "lint": "biome check src/ && eslint src/",
    "lint:fix": "biome check --write src/",
    "lint:biome": "biome check src/",
    "lint:eslint": "eslint src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@corvu/drawer": "^0.2.4",
    "@corvu/otp-field": "^0.1.4",
    "@corvu/resizable": "^0.2.5",
    "@geoman-io/leaflet-geoman-free": "^2.19.2",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@kobalte/core": "^0.13.11",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@solid-primitives/i18n": "^2.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "^1.166.2",
    "@tanstack/solid-form": "^1.28.4",
    "@tanstack/solid-query": "^5.90.23",
    "@tanstack/solid-query-devtools": "^5.91.3",
    "@tanstack/solid-router": "^1.166.2",
    "@tanstack/solid-router-devtools": "^1.166.2",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/solid-virtual": "^3.13.21",
    "@tanstack/valibot-adapter": "^1.166.2",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-solid": "^8.6.0",
    "gsap": "^3.14.2",
    "leaflet": "^1.9.4",
    "quill": "^2.0.3",
    "socket.io-client": "^4.8.3",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.11",
    "solid-sonner": "^0.2.8",
    "terra-draw": "^1.25.0",
    "terra-draw-google-maps-adapter": "^1.3.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/devtools-vite": "^0.5.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^28.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.18"
  }
}
